#!/bin/sh
# agri-main pre-commit gate. Install once: git config core.hooksPath scripts/git-hooks
# Skip in an emergency: git commit --no-verify
set -e
WIDGET_DIR="$(git rev-parse --show-toplevel)"
CLIENT_DIR="$WIDGET_DIR/../../.."
cd "$CLIENT_DIR"

echo "[pre-commit] quality gate"
node your-extensions/widgets/agri-main/scripts/check-quality.mjs > /dev/null
echo "[pre-commit] network timeouts"
node your-extensions/widgets/agri-main/scripts/check-network-timeouts.mjs
echo "[pre-commit] eslint"
npx eslint your-extensions/widgets/agri-main/src --ext .ts,.tsx
echo "[pre-commit] jest"
npx jest -c your-extensions/widgets/agri-main/jest.config.js --silent
